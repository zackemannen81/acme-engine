{
  "name": "acme-engine",
  "version": "0.1.5",
  "description": "ACME model execution runtime for provider-neutral AI systems",
  "type": "module",
  "license": "Apache-2.0",
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
