  },
  "dependencies": {
    "@acme-engine/model-runtime": "workspace:*"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zackemannen81/acme-engine.git",
    "directory": "packages/acme-engine"
  },
  "publishConfig": {
    "access": "public"
  }
}
